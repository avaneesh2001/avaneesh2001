---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"img">, "src" | "alt" | "width" | "height"> & {
  /** Path relative to src/assets, e.g. "images/gold_medal.JPG". */
  src: string;
  alt: string;
  /** Largest width the image is shown at, in CSS pixels. */
  displayWidth?: number;
  sizes?: string;
};

// Card images render at most ~560px wide on desktop and full width on small screens.
const { src, alt, displayWidth = 600, sizes = "(max-width: 920px) 100vw, 600px", ...attributes } = Astro.props;

// Content files name images by path; resolve them to imported assets so Astro
// can resize them and convert them to WebP at build time.
const assets = import.meta.glob<{ default: ImageMetadata }>("../assets/**/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG}", { eager: true });
const key = `../assets/${src.replace(/^\/+/, "")}`;
const asset = assets[key]?.default;
if (!asset) throw new Error(`SiteImage: no image at src/assets/${src}`);

// Offer 1x and 2x versions of the display width, never upscaling past the original.
const widths = [...new Set([displayWidth, displayWidth * 2].map((width) => Math.min(width, asset.width)))];
---

<Image src={asset} alt={alt} widths={widths} sizes={sizes} format="webp" quality={78} {...attributes} />
