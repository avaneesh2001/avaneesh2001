---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getContentFile } from "@lib/content";
import { withBase } from "@lib/paths";
import type { HomeContent } from "../types/content";

const homeContent = getContentFile<HomeContent>("home");
const aboutParagraphs = homeContent.about_scroll.body.split("\n").map((line) => line.trim()).filter(Boolean);
---

<BaseLayout title="Home" description={homeContent.hero.hero_subheadline} accent="sapphire" isHome>
  <section class="hero-section">
    <div class="hero-copy" data-reveal>
      <p class="eyebrow">Portfolio dossier</p>
      <h1>{homeContent.hero.hero_headline}</h1>
      <p>{homeContent.hero.hero_subheadline}</p>
      <div class="button-row hero-buttons">
        <a class="button button-primary" href={withBase(homeContent.hero.primary_cta_href)}>{homeContent.hero.primary_cta_label}<span class="visually-hidden"> (PDF)</span></a>
        <a class="button button-secondary" href={homeContent.contact_card.email_href}>Email</a>
        <a class="button button-secondary" href={homeContent.hero.linkedin_cta_href}>{homeContent.hero.linkedin_cta_label}</a>
        <a class="button button-secondary" href={homeContent.hero.secondary_cta_href}>{homeContent.hero.secondary_cta_label}</a>
      </div>
    </div>
    <!-- The one sticky note on the site: notes are only used for things that really are notes. -->
    <aside class="sticky-note" aria-labelledby="current-focus-heading" data-reveal>
      <h2 id="current-focus-heading">{homeContent.hero_archive_card.label}</h2>
      <ul>
        <li>{homeContent.hero_archive_card.line_one}</li>
        <li>{homeContent.hero_archive_card.line_two}</li>
        <li>{homeContent.hero_archive_card.line_three}</li>
      </ul>
    </aside>
  </section>

  <section class="about-scroll-section" aria-labelledby="about-scroll-heading">
    <article class="about-scroll" data-reveal>
      <div class="scroll-rod scroll-rod-top" aria-hidden="true"></div>
      <div class="scroll-paper">
        <div class="scroll-copy">
          <p class="eyebrow">{homeContent.about_scroll.eyebrow}</p>
          <h2 id="about-scroll-heading">{homeContent.about_scroll.headline}</h2>
          {/* The first paragraph always shows; on phones the rest stays rolled up until asked for. */}
          <p>{aboutParagraphs[0]}</p>
          {aboutParagraphs.length > 1 && (
            <>
              <div class="about-more" id="about-more" data-about-more>
                {aboutParagraphs.slice(1).map((paragraph) => <p>{paragraph}</p>)}
              </div>
              <button class="about-more-toggle" type="button" aria-expanded="true" aria-controls="about-more" hidden data-about-more-toggle>
                Unroll the rest
              </button>
            </>
          )}
        </div>
        <aside class="scroll-note">
          <span></span>
          <p>{homeContent.about_scroll.side_note}</p>
        </aside>
      </div>
      <div class="scroll-rod scroll-rod-bottom" aria-hidden="true"></div>
    </article>
  </section>

  <section class="content-section">
    <div class="section-heading" data-reveal>
      <p class="eyebrow">Selected impact</p>
      <h2>Highlights at a glance</h2>
    </div>
    <div class="impact-grid">
      {homeContent.selected_impact_items.map((impactItem) => (
        <article class="paper-card impact-card" data-reveal>
          <span class="card-pin"></span>
          <h3>{impactItem.title}</h3>
          <p>{impactItem.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="content-section">
    <div class="section-heading" data-reveal>
      <p class="eyebrow">Open a file</p>
      <h2>Explore the archive</h2>
    </div>
    <div class="preview-grid">
      {homeContent.section_preview_cards.map((previewCard) => (
        <a class={`folder-card accent-${previewCard.accent}`} href={withBase(previewCard.href)} data-reveal>
          <span class="folder-tab"></span>
          <span class="folder-label">{previewCard.title}</span>
          <strong>{previewCard.description}</strong>
        </a>
      ))}
    </div>
  </section>

  <section class="home-contact-section" aria-label="Contact">
    <article class="contact-card paper-card" data-reveal>
      <div>
        <p class="eyebrow">{homeContent.contact_card.eyebrow}</p>
        <h2>{homeContent.contact_card.headline}</h2>
        <p>{homeContent.contact_card.description}</p>
      </div>
      <div class="contact-link-stack">
        <a href={homeContent.contact_card.email_href}>{homeContent.contact_card.email_label}</a>
        <a href={homeContent.contact_card.linkedin_href}>{homeContent.contact_card.linkedin_label}</a>
        <a href={homeContent.contact_card.github_href}>{homeContent.contact_card.github_label}</a>
      </div>
    </article>
  </section>

  <script>
    // On phones, keep the About scroll short: roll up everything after the first paragraph.
    const more = document.querySelector("[data-about-more]");
    const toggle = document.querySelector("[data-about-more-toggle]");
    if (more instanceof HTMLElement && toggle instanceof HTMLButtonElement && window.matchMedia("(max-width: 720px)").matches) {
      const setOpen = (open: boolean) => {
        more.classList.toggle("is-rolled", !open);
        toggle.setAttribute("aria-expanded", String(open));
        toggle.textContent = open ? "Roll it back up" : "Unroll the rest";
      };
      toggle.hidden = false;
      setOpen(false);
      toggle.addEventListener("click", () => setOpen(more.classList.contains("is-rolled")));
    }
  </script>
</BaseLayout>
